# Copy this file to .env and fill in real values. Never commit .env.
DISCORD_TOKEN=your-bot-token-here

# Optional: restrict slash command sync to one guild for instant updates during dev.
# Leave blank to sync globally (takes up to an hour to propagate).
GUILD_ID=

# Role ID that is allowed to run admin-only commands even without Discord "Administrator" perms.
# Leave blank to rely solely on Discord permissions.
ADMIN_ROLE_ID=

# Role ID that can manage CTF challenges (/ctf add, /ctf remove) without needing
# full staff permissions. Staff (see ADMIN_ROLE_ID above) can always do this too.
# Leave blank to restrict CTF management to staff only.
CTF_ADMIN_ROLE_ID=

# Role ID auto-granted to members who fully complete the Linux Luminarium
# dojo on pwn.college (see /pwn link). Leave blank to disable role granting
# - progress tracking still works either way.
PWNCOLLEGE_COMPLETION_ROLE_ID=
